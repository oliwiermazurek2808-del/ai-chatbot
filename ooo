## src/App.jsx

```jsx
import React from 'react'
import Header from './components/Header'
import Hero from './components/Hero'
import ProductCard from './components/ProductCard'
import Footer from './components/Footer'

const DUMMY_PRODUCTS = [
  { id:1, name:'Bezkontaktowy licznik kroków', price:39.99, img:'' },
  { id:2, name:'Silikonowa butelka sportowa', price:19.9, img:'' },
  { id:3, name:'Mata do ćwiczeń 6mm', price:25.0, img:'' },
  { id:4, name:'Skakanka z licznikiem', price:15.5, img:'' }
]

export default function App(){
  return (
    <div className="min-h-screen bg-gradient-to-b from-white via-slate-50 to-white text-slate-900">
      <Header />
      <main className="max-w-6xl mx-auto px-4 py-8">
        <Hero />

        <section className="mt-8">
          <h2 className="text-2xl font-semibold">Polecane produkty</h2>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-4">
            {DUMMY_PRODUCTS.map(p => <ProductCard key={p.id} product={p} />)}
          </div>
        </section>

      </main>
      <Footer />
    </div>
  )
}
```

